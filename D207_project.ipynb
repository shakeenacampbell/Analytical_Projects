   "source": [
    "# replace outliers\n",
    "outlier_columns= ['VitD_supp', 'Latitude', 'Longitude', 'Population', 'Children', 'Age', 'Income', 'VitD_levels', 'Doc_visits', 'Full_meals_eaten', 'Initial_days', 'DailyCharge', 'Additional_charges']\n",
    "def rep_outliers_median(df, columns):\n",
    "\n",
    "    for col in columns:\n",
    "        Q1 = df[col].quantile(0.25)\n",
    "        Q3 = df[col].quantile(0.75)\n",
    "        IQR = Q3 - Q1\n",
    "        lower_bound = Q1 - (1.5 * IQR)\n",
    "        upper_bound = Q3 + (1.5 * IQR)\n",
    "        df[col] = np.where((df[col] < lower_bound) | (df[col] > upper_bound), np.nan, df[col])\n",
    "        return df\n",
    "\n",
    "rep_outliers_median(df,[outlier_columns])"
   ]
  },
